<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration
    ================================
    - Production (release): All traffic must use HTTPS. Cleartext (HTTP) is blocked.
    - Debug only: cleartext traffic is allowed to the Android emulator host (10.0.2.2)
      so local Grafana / New Relic mock servers can be reached during development.

    Reference: https://developer.android.com/training/articles/security-config
-->
<network-security-config>

    <!-- Default policy: HTTPS only for all domains -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust system CA store (standard CAs) -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Debug only: allow HTTP to emulator host for local dev servers -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <!-- Allow user-installed CAs in debug builds (e.g. Charles Proxy) -->
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

    <!--
        Allow cleartext traffic to localhost / emulator IPs in debug builds.
        10.0.2.2 = Android emulator loopback to host machine
        10.0.3.2 = Genymotion emulator loopback to host machine
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

</network-security-config>
