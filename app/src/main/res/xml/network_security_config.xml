<?xml version="1.0" encoding="utf-8"?>
<!--
    Release Network Security Configuration
    ======================================
    All traffic must use HTTPS. Cleartext (HTTP) is blocked.
    Emulator/localhost cleartext is provided only in the debug source set.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
