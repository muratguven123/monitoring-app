# Copy to keystore.properties (gitignored) or set env vars for release signing.
# Do not commit real passwords or keystore files.
#
# keystorePath=C:\\path\\to\\monitoring-release.jks
# keystorePassword=your-store-password
# keyAlias=monitoring
# keyPassword=your-key-password
#
# Equivalent CI / shell environment variables:
#   KEYSTORE_PATH, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD

keystorePath=
keystorePassword=
keyAlias=
keyPassword=
