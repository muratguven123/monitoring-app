# Copy to keystore.properties in the project root (gitignored).
# Do not commit real passwords or keystore files.
#
# storeFile is relative to the app/ module (e.g. app/release-key.jks).
#
# storePassword=your-store-password
# keyPassword=your-key-password
# keyAlias=my-key-alias
# storeFile=release-key.jks
#
# Legacy keys (still supported):
#   keystorePath / keystorePassword / keyAlias / keyPassword
#
# CI environment variables:
#   KEYSTORE_PATH, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD

storePassword=
keyPassword=
keyAlias=my-key-alias
storeFile=release-key.jks
